# Production deployment values. Replace every placeholder before deployment.
DATABASE_URL=ecto://user:replace-me@postgres.example.invalid/database
STORE_DIRECT_DATABASE_URL=
STORE_DB_POOL_MODE=session
POOL_SIZE=10
ECTO_IPV6=false
SECRET_KEY_BASE=replace-with-a-generated-secret
SENTRY_DSN=https://public@example.invalid/1
STORE_LOG_LEVEL=info
STORE_LOG_FORMAT=text
STORE_CSP_MODE=disabled
STORE_CSP_POLICY=default-src 'self'; script-src 'self' https://js.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; connect-src 'self' https://api.stripe.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'
STORE_CSP_REPORT_URI=
STORE_TOKEN_SIGNING_SECRET=replace-with-a-generated-secret
STORE_GOOGLE_CLIENT_ID=replace-with-client-id
STORE_GOOGLE_CLIENT_SECRET=replace-with-client-secret
STORE_GOOGLE_REDIRECT_URI_BASE=https://example.invalid/auth
STORE_QUOTE_HASH_SECRET=replace-with-a-generated-secret
PHX_HOST=example.invalid
DNS_CLUSTER_QUERY=
STORE_CLUSTER_TRANSPORT=inet6
STORE_TRUSTED_PROXY_PROXIES=
STORE_TRUSTED_PROXY_HEADERS=cf-connecting-ip,x-forwarded-for
STORE_PAYMENTS_ENABLED_PROVIDERS=
STORE_PAYMENTS_DEFAULT_PURCHASE_PROVIDER_FOR_UI=
STORE_STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STORE_STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STORE_STRIPE_PUBLISHABLE_KEY=replace-with-stripe-publishable-key
STORE_STRIPE_API_BASE_URL=https://api.stripe.com
