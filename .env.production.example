STORE_PAYMENT_TIMEOUT_MS=5000
STORE_PAYMENT_PROVIDER_TASK_TIMEOUT_MS=4000
STORE_PAYMENT_HTTP_POOL_SIZE=400
STORE_PAYMENT_HTTP_RECEIVE_TIMEOUT_MS=6000
STORE_PAYMENT_HTTP_POOL_TIMEOUT_MS=5000
STORE_COMMS_PROVIDER=swoosh
STORE_POSTMARK_SERVER_TOKEN=replace-with-postmark-token
STORE_POSTMARK_URL=https://api.postmarkapp.com/email
STORE_COMMS_FROM_NAME=Store
STORE_COMMS_FROM_EMAIL=no-reply@example.com
STORE_COMMS_SUPPORT_EMAIL=support@example.com
STORE_DIGITAL_STORAGE_PROVIDER=s3
STORE_DIGITAL_ALLOWED_REDIRECT_HOSTS=downloads.example.com
