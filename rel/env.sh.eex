#!/bin/sh

release_name="<%= @release.name %>"

if [ -z "${RELEASE_DISTRIBUTION:-}" ]; then
  export RELEASE_DISTRIBUTION="name"
fi

case "${STORE_CLUSTER_TRANSPORT:-inet6}" in
  inet6)
    export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -proto_dist inet6_tcp"
    ;;
  inet)
    export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -proto_dist inet_tcp"
    ;;
esac

if [ -z "${RELEASE_NODE:-}" ]; then
  replica_id="${RAILWAY_REPLICA_ID:-$(hostname)}"
  private_ip="${RAILWAY_PRIVATE_IP:-$(hostname -i | awk '{print $1}')}"
  export RELEASE_NODE="${release_name}-${replica_id}@${private_ip}"
fi

if [ -z "${DNS_CLUSTER_QUERY:-}" ] && [ -n "${RAILWAY_PRIVATE_DOMAIN:-}" ]; then
  export DNS_CLUSTER_QUERY="${RAILWAY_PRIVATE_DOMAIN}"
fi
